# ai-runtime: оркестратор n8n (внутренние URL docker-сети).
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_ORCHESTRATOR=n8n
AI_N8N_ENABLED=true
N8N_WEBHOOK_URL=http://n8n:5678/webhook/chat-orchestrator
AI_N8N_WAIT_TIMEOUT_SECONDS=90
# Java HttpClient: в Docker иногда зависает на IPv6 для hostname n8n
JAVA_TOOL_OPTIONS=-Djava.net.preferIPv4Stack=true
