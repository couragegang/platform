# n8n orchestrator (VPS). Public UI: https://ai-test.valoriel.ru/n8n/ | https://ai.valoriel.ru/n8n/
# (bake по контуру; не VPS_PUBLIC_BASE_URL). Override: N8N_PUBLIC_BASE_URL в CI.
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Moscow
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
WEBHOOK_URL=http://n8n:5678/
N8N_TOOL_STEP_WEBHOOK_URL=http://n8n:5678/webhook/chat-tool-step
N8N_PROXY_HOPS=1
