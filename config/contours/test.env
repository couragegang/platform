# Контур test (CI / staging): дефолты для прогона без GitHub Secrets.
# В GitHub Environment «test» задайте те же имена — они перекроют значения ниже.

DEPLOY_CONTOUR=test

JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
CONFIG_INTERNAL_API_KEY=test-internal-key
POLICY_INTERNAL_API_KEY=test-internal-key
SECRETS_INTERNAL_API_KEY=test-internal-key
AUDIT_INTERNAL_API_KEY=test-internal-key
DB_PASSWORD=platform

LLM_PROVIDER=stub
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=disabled
