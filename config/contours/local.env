# Контур local: безопасные dev-значения (можно коммитить).
# Переопределяются platform/.env (приоритет выше).

DEPLOY_CONTOUR=local

JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
CONFIG_INTERNAL_API_KEY=dev-internal-key
POLICY_INTERNAL_API_KEY=dev-internal-key
SECRETS_INTERNAL_API_KEY=dev-internal-key
AUDIT_INTERNAL_API_KEY=dev-internal-key
DB_PASSWORD=platform

LLM_PROVIDER=stub
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com
