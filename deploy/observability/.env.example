# Скопируйте в .env (не коммитить). На VPS — /opt/couragegang-observability/.env

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# Публичный URL Grafana (обязательно со слэшем в конце).
# Subpath за nginx (/grafana/): включите GRAFANA_SERVE_FROM_SUB_PATH=true
GRAFANA_ROOT_URL=https://ai-test.valoriel.ru/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true

# Host-порт Grafana на VPS (127.0.0.1:3000 — только localhost, снаружи через nginx)
GRAFANA_HOST_PORT=3000

# Local only: Prometheus UI (9090)
PROMETHEUS_HOST_PORT=9090
