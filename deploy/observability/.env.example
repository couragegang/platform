# Скопируйте в .env (не коммитить). На VPS — /opt/couragegang-observability/.env

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# Публичный URL Grafana (для ссылок в UI / OIDC позже)
GRAFANA_ROOT_URL=http://your-vps-host:3000

# Host-порт Grafana (3000 или 13000 если занят)
GRAFANA_HOST_PORT=3000

# Local only: Prometheus UI (9090)
PROMETHEUS_HOST_PORT=9090
